# Local development uses this exact destination; keep the password private in .env.local.
DATABASE_URL="postgresql://opco_dev:LOCAL_PASSWORD@127.0.0.1:55432/opco_development?schema=public"

# Required only by the synthetic local seed. Use a unique local password (12+ characters).
OPCO_DEV_SEED_PASSWORD="replace-with-a-local-only-password"

# Authentication secret. Generate and set this before running Auth.js.
AUTH_SECRET="replace-with-a-generated-secret"

# External API JWT secret. Generate a separate stable secret for /api/v1 bearer tokens.
API_AUTH_SECRET="replace-with-a-separate-generated-secret"

# Comma-separated browser origins allowed to call /api/v1 with CORS.
API_ALLOWED_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:19102"

# Local application URL for Auth.js.
AUTH_URL=http://localhost:3000
