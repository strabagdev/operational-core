      "title": "Entregas",
      "datasetId": "daily",
      "visualization": {
        "type": "KPI",
        "config": {
          "metricId": "total",
          "label": "Entregas",
          "format": "INTEGER"
        }
      },
      "layout": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2
      }
    },
    {
